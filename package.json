{
  "name": "lacak-lamaran",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "trap 'kill 0' EXIT; npm run dev:server & npm run dev:web",
    "dev:web": "vite",
    "dev:server": "node --env-file=.env --watch --experimental-strip-types server/index.ts",
    "build": "tsc -b && vite build",
    "postinstall": "npm run build",
    "start": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "preview": "vite preview",
    "test": "node --env-file=.env --experimental-strip-types --test --test-concurrency=1",
    "lint": "biome check .",
    "format": "biome check --write .",
    "migrate": "node --env-file-if-exists=.env --experimental-strip-types server/migrate.ts",
    "db:generate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs generate"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "aws4fetch": "^1.0.20",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "mysql2": "^3.23.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
