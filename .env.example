# Salin berkas ini jadi .env lalu isi nilainya.
# .env TIDAK PERNAH masuk git. Berkas ini yang masuk, sebagai dokumentasi nama variabel.

# ── Database ────────────────────────────────────────────────────────────────
# Format: mysql://pengguna:sandi@host:3306/nama_database
# Di Hostinger, host-nya "localhost" karena aplikasi Node jalan di mesin yang sama.
# Untuk ngoding di laptop: MySQL 8 lokal, database app_tracker.
# Jangan pernah menunjuk .env lokal ke database produksi.
DATABASE_URL=mysql://PENGGUNA:SANDI@127.0.0.1:3306/app_tracker

# ── Sesi ────────────────────────────────────────────────────────────────────
# Acak 32 byte. Buat dengan:  openssl rand -hex 32
# Menggantinya memutus semua sesi yang sedang berjalan.
SESSION_SECRET=

# ── Google Identity Services ────────────────────────────────────────────────
# Dari Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (tipe: Web application).
# Authorized JavaScript origins wajib memuat http://localhost:5173 dan domain produksi.
# Ini satu-satunya rahasia yang boleh sampai ke peramban, dan memang dirancang publik.
VITE_GOOGLE_CLIENT_ID=

# ── Cloudflare R2 (baru dipakai di M2) ──────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Email (baru dipakai di M2) ──────────────────────────────────────────────
RESEND_API_KEY=

# ── Alamat aplikasi ─────────────────────────────────────────────────────────
# Dipakai untuk menyusun tautan di email dan pengalihan setelah masuk.
APP_URL=http://localhost:5173
